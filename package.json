{
  "name": "grido",
  "productName": "Tiệm Ghép Ảnh",
  "description": "Ghép ảnh nhiều bố cục, xuất ảnh sắc nét cho Instagram, Facebook, TikTok.",
  "author": "LA PHUOC LOC",
  "repository": "github:LaPhuocLoc/Grido",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -b",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "app.grido.desktop",
    "productName": "Tiệm Ghép Ảnh",
    "executableName": "TiemGhepAnh",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "artifactName": "TiemGhepAnh-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.photography",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Graphics",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LaPhuocLoc",
        "repo": "Grido"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TiemGhepAnh-Setup-${version}.${ext}",
      "shortcutName": "Tiệm Ghép Ảnh"
    }
  }
}
